<section class="stats panel" aria-labelledby="stats-title">
  <h2 id="stats-title" class="panel-title">Scorecard</h2>
  <dl class="stats-list">
    <div class="stat">
      <dt>Time</dt>
      <dd class="mono" id="stat-time">00:00</dd>
    </div>
    <div class="stat">
      <dt>Rectangles</dt>
      <dd class="mono" id="stat-rectangles">0 / 0</dd>
    </div>
    <div class="stat">
      <dt>Done</dt>
      <dd class="mono" id="stat-percent">0%</dd>
    </div>
    <div class="stat">
      <dt>Moves</dt>
      <dd class="mono" id="stat-moves">0</dd>
    </div>
    <div class="stat">
      <dt>Difficulty</dt>
      <dd id="stat-difficulty">Easy</dd>
    </div>
  </dl>
  <div class="progress-block">
    <div class="progress-label">
      <span>Progress</span>
      <span class="mono" id="progress-text">0 / 0 locked</span>
    </div>
    <div class="progress" id="progress" role="progressbar" aria-label="Puzzle progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="progress-fill" id="progress-fill"></div>
    </div>
  </div>
</section>
